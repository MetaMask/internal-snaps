{
  /**
   * This configuration is extended by the `tsconfig.json` configuration in each package.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /**
     * Resolve `@metamask/*` imports to uncompiled source for packages in this
     * repo. Paths are relative to this file (the monorepo root), not to each
     * package that extends it.
     *
     * NOTE: This must be synchronized with the `moduleNameMapper` option in
     * `jest.config.packages.js` and `jest.config.snaps.unit.js`.
     */
    "paths": {
      "@metamask/*": ["./packages/*/src"]
    }
  }
}
