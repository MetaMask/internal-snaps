{
  /**
   * Shared settings for package source, editor, and type-checking configurations.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true,
    /**
     * Resolve local `@metamask/*` imports to source so editors and TypeScript checks use the
     * uncompiled monorepo packages.
     *
     * NOTE: This must be synchronized with the `moduleNameMapper` option in
     * `jest.config.packages.js`.
     */
    "paths": {
      "@metamask/*": ["../*/src"]
    },
    "skipLibCheck": true
  }
}
