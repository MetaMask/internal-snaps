{
  /**
   * Shared settings for all packages, whether a Snap or not.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true,
    /**
     * Resolve local `@metamask/*` imports to source so editors and TypeScript checks use the
     * uncompiled monorepo packages.
     *
     * NOTE: This must be synchronized with the `moduleNameMapper` option in
     * `jest.config.packages.js`.
     */
    "paths": {
      "@metamask/*": ["../*/src"]
    },
    "skipLibCheck": true,
    "types": ["jest"]
  },
  /**
   * Keep build and test-coverage artifacts out of every package's check program.
   *
   * NOTE: `include`/`exclude` paths are resolved relative to the config file that declares
   * them, so these must be root-relative globs rather than `./dist`-style paths. Also note
   * that a child configuration defining its own `exclude` replaces this one entirely.
   */
  "exclude": ["**/dist", "**/coverage"]
}
