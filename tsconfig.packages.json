{
  /**
   * This configuration is extended by the `tsconfig.json` configuration in each package.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /**
     * Map only in-repo packages to their uncompiled source.
     * Do not use a catch-all `@metamask/*` mapping: most `@metamask/*`
     * packages are published dependencies, and a parent-directory glob
     * can resolve to sibling checkouts outside this repo 
     * when a tsconfig has no `baseUrl`.
     *
     * NOTE: Keep this in sync with `moduleNameMapper` in
     * `jest.config.packages.js` for packages that live in this repo.
     */
    "paths": {
      "@metamask/snap-networks-utils": ["../snap-networks-utils/src"],
      "@metamask/snap-networks-utils/*": ["../snap-networks-utils/src/*"]
    }
  }
}
