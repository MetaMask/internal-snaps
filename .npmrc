# Supply-chain hardening for anyone reaching for npm in this repo (it is a Yarn
# project; see .yarnrc.yml for the equivalent Yarn settings).
# https://lavamoat.github.io/guides/hardening-dev/

# Never run package lifecycle scripts.
ignore-scripts=true

# Don't install packages published less than 3 days ago.
min-release-age=3

# Disallow Git dependencies.
allow-git=none

# Make the `git` command fail: `false` is not a boolean here, it's the POSIX
# shell command that always exits non-zero.
git=false
