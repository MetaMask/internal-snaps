{
  "extends": "../../tsconfig.snaps.json",
  "compilerOptions": {
    "baseUrl": "./",
    "lib": ["ES2023", "DOM"],
    "target": "es2023",
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts", "**/*.tsx", "locales/*.json"]
}
