{
  "name": "@metamask/stellar-wallet-snap",
  "version": "2.1.0",
  "description": "A Stellar wallet Snap",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/internal-snaps/tree/main/packages/stellar-wallet-snap#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/internal-snaps/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/internal-snaps.git"
  },
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json",
    "locales/"
  ],
  "main": "./dist/bundle.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "allow-scripts": "yarn workspace root allow-scripts",
    "build": "mm-snap build --preinstalled && yarn build:locale",
    "build:dev": "ENVIRONMENT=local node scripts/update-manifest-local.js && mm-snap build && yarn build:locale",
    "build:prod": "ENVIRONMENT=production node scripts/update-manifest-local.js && yarn build:locale && mm-snap build --preinstalled",
    "build:locale": "node ./scripts/populate-en-locale.js && oxfmt 'locales/**/*.json'",
    "build:locale:watch": "npx nodemon --watch messages.json --exec \"node ./scripts/populate-en-locale.js && oxfmt 'locales/**/*.json'\"",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/stellar-wallet-snap",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/stellar-wallet-snap",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "clean": "rimraf dist",
    "prepublishOnly": "mm-snap manifest",
    "publish:preview": "yarn npm publish --tag preview",
    "serve": "mm-snap serve",
    "start": "node scripts/update-manifest-local.js && concurrently \"mm-snap watch\" \"yarn build:locale:watch\"",
    "test": "vitest run --coverage --reporter=dot --silent",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest --silent"
  },
  "devDependencies": {
    "@metamask/assets-controller": "^19.1.0",
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/key-tree": "^10.1.1",
    "@metamask/keyring-api": "^24.1.0",
    "@metamask/keyring-snap-sdk": "^10.0.0",
    "@metamask/messenger": "^2.0.0",
    "@metamask/remote-feature-flag-controller": "^7.0.0",
    "@metamask/snap-networks-utils": "^3.2.0",
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-sdk": "^12.0.1",
    "@metamask/superstruct": "^3.4.1",
    "@metamask/utils": "^12.0.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "async-mutex": "^0.5.0",
    "bignumber.js": "^9.3.1",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.1",
    "isomorphic-fetch": "^3.0.0",
    "lodash": "^4.17.21",
    "oxfmt": "^0.70.0",
    "qrcode-generator": "^2.0.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "5.107.2"
  },
  "engines": {
    "node": "^22.14.0 || ^24"
  }
}
