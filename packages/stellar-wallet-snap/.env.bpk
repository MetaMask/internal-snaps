# Use:
# - local for local development
# - test for running tests locally (mandatory)
# - production before submitting a PR
ENVIRONMENT=local

# Use:
# - all for all logs
# - error for error logs
# - warn for warn logs
# - info for info logs
# - debug for debug logs
# - silent for silent logs
LOG_LEVEL=trace

