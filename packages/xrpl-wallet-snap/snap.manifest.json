{
  "version": "0.0.1",
  "description": "Manage Xrpl using MetaMask",
  "proposedName": "Xrpl",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/internal-snaps.git"
  },
  "source": {
    "shasum": "4owU881++PE69tUMQtTWYpChAMr0MSa0ZMPt+RhYihE=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "images/icon.svg",
        "packageName": "@metamask/xrpl-wallet-snap",
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "initialConnections": {
    "https://portfolio.metamask.io": {}
  },
  "initialPermissions": {
    "endowment:keyring": {
      "allowedOrigins": ["https://portfolio.metamask.io"],
      "capabilities": {
        "scopes": ["xrpl:0"],
        "bip44": {
          "deriveIndex": true,
          "deriveIndexRange": true,
          "discover": true
        }
      }
    },
    "snap_getBip32Entropy": [
      {
        "path": ["m", "44'", "144'"],
        "curve": "ed25519"
      },
      {
        "path": ["m", "44'", "144'"],
        "curve": "secp256k1"
      }
    ],
    "endowment:network-access": {},
    "snap_manageAccounts": {},
    "snap_manageState": {},
    "snap_dialog": {},
    "snap_getPreferences": {},
    "endowment:cronjob": {},
    "endowment:assets": {
      "scopes": ["xrpl:0"]
    },
    "endowment:messenger": {
      "actions": [
        "RemoteFeatureFlagController:getState",
        "AssetsController:getAccountAssetByID",
        "AssetsController:getAccountAssetsByIDs",
        "AssetsController:getAccountAssetsByScope",
        "AssetsController:getAssetMetadata"
      ]
    }
  },
  "platformVersion": "12.0.1",
  "manifestVersion": "0.1"
}
