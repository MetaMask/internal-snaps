# Use:
# - local for local development
# - test for running tests locally (mandatory)
# - production before submitting a PR
ENVIRONMENT=local

# Log Level
# Possible Options: error, warn, info, debug, trace, silent
LOG_LEVEL=silent

# Mainnet rippled JSON-RPC URL
XRPL_RPC_URL_MAINNET=https://xrplcluster.com

# Mainnet Clio URL (account_tx / MPT reads)
XRPL_CLIO_URL_MAINNET=https://s1.ripple.com:51234

# Mainnet Explorer Base URLs
XRPL_EXPLORER_MAINNET_BASE_URL=https://xrpscan.com/

# Token API Base URL
TOKEN_API_BASE_URL=https://tokens.api.cx.metamask.io

# Static API Base URL
STATIC_API_BASE_URL=https://static.cx.metamask.io

# Price API Base URL
PRICE_API_BASE_URL=https://price.api.cx.metamask.io

# Security Alerts API Base URL
SECURITY_ALERTS_API_BASE_URL=https://security-alerts.api.cx.metamask.io

# Cache TTL Milliseconds for base fee
#XRPL_BASE_FEE_TTL_MILLISECONDS=

# Cache TTL Milliseconds for load on chain account
#XRPL_LOAD_ON_CHAIN_ACCOUNT_TTL_MILLISECONDS=

# Cache TTL Milliseconds for simulate transaction
#XRPL_SIMULATE_TRANSACTION_TTL_MILLISECONDS=

# Cache TTL Milliseconds for the keyring live account reused by getAccountBalances
#XRPL_KEYRING_LIVE_ACCOUNT_TTL_MILLISECONDS=

# Cache TTL Milliseconds for spot prices
#XRPL_SPOT_PRICES_TTL_MILLISECONDS=

# Cache TTL Milliseconds for token API asset catalog
#XRPL_ASSET_METADATA_TTL_MILLISECONDS=

# NetworkService read caches. sendTransaction is not cached.
#XRPL_DEPOSIT_AUTHORIZED_TTL_MILLISECONDS=
#XRPL_ACCOUNT_INFO_TTL_MILLISECONDS=
#XRPL_ACCOUNT_TRUSTLINES_TTL_MILLISECONDS=
#XRPL_ACCOUNT_MPTOKENS_TTL_MILLISECONDS=
#XRPL_TRANSACTION_TTL_MILLISECONDS=
#XRPL_VALIDATED_LEDGER_INDEX_TTL_MILLISECONDS=
#XRPL_ACCOUNT_TRANSACTIONS_TTL_MILLISECONDS=

# Inclusion fee multiplier (applied to Xrpl network base fee per operation)
#XRPL_BASE_FEE_MULTIPLIER=

# Maximum fee threshold in XRP
#XRPL_MAX_FEE_THRESHOLD_IN_XRP=

# Maximum background reschedules for the track-transaction cron job while the
# transaction is not yet found on ledger
#XRPL_TRACK_TRANSACTION_MAX_RESCHEDULES=10

# Maximum number of reconcile attempts for a pending transaction
#XRPL_MAX_RECONCILE_ATTEMPTS=5

# Maximum age of a pending transaction in milliseconds
#XRPL_MAX_PENDING_TRANSACTION_AGE=30000
