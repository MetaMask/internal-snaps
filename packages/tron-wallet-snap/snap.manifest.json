{
  "version": "2.0.0",
  "description": "Manage Tron using MetaMask",
  "proposedName": "Tron",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/internal-snaps.git"
  },
  "source": {
    "shasum": "F3eaE0qVHHOHIRCGgPpluoGH5XmrorIMy/0ZHhBkBs0=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "images/icon.svg",
        "packageName": "@metamask/tron-wallet-snap",
        "registry": "https://registry.npmjs.org/"
      }
    },
    "locales": ["locales/en.json"]
  },
  "initialConnections": {
    "https://portfolio.metamask.io": {}
  },
  "initialPermissions": {
    "endowment:keyring": {
      "allowedOrigins": ["https://portfolio.metamask.io"],
      "capabilities": {
        "scopes": ["tron:728126428"],
        "privateKey": {
          "exportFormats": [
            {
              "encoding": "hexadecimal"
            }
          ]
        },
        "bip44": {
          "deriveIndex": true,
          "deriveIndexRange": true,
          "discover": true
        }
      }
    },
    "snap_getBip32Entropy": [
      {
        "path": ["m", "44'", "195'"],
        "curve": "secp256k1"
      }
    ],
    "endowment:network-access": {},
    "snap_manageAccounts": {},
    "snap_manageState": {},
    "snap_dialog": {},
    "snap_getPreferences": {},
    "endowment:cronjob": {
      "jobs": [
        {
          "duration": "PT60S",
          "request": {
            "method": "onSynchronizeSelectedAccountsCronjob"
          }
        }
      ]
    },
    "endowment:assets": {
      "scopes": ["tron:728126428"]
    }
  },
  "platformVersion": "11.2.0",
  "manifestVersion": "0.1"
}
