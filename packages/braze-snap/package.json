{
  "name": "@metamask/braze-snap",
  "version": "0.0.0",
  "description": "Runs the Braze Web SDK for MetaMask in an isolated snap",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/internal-snaps/tree/main/packages/braze-snap#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/internal-snaps/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/internal-snaps.git"
  },
  "files": [
    "dist/",
    "snap.manifest.json",
    "images/",
    "locales/"
  ],
  "main": "./dist/bundle.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "allow-scripts": "yarn workspace root allow-scripts",
    "build": "mm-snap build --preinstalled",
    "build:clean": "yarn clean && yarn build",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/braze-snap",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/braze-snap",
    "clean": "rimraf dist",
    "prepublishOnly": "mm-snap manifest",
    "publish:preview": "yarn npm publish --tag preview",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
    "test": "vitest run --coverage --reporter=dot --silent",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest --silent",
    "since-latest-release": "../../scripts/since-latest-release.sh"
  },
  "devDependencies": {
    "@braze/web-sdk": "7.0.0",
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-sdk": "^12.0.1",
    "@metamask/superstruct": "^3.4.1",
    "@metamask/utils": "^11.11.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "nock": "^13.3.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "5.107.2"
  },
  "engines": {
    "node": "^22.14.0 || ^24"
  }
}
