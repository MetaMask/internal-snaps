{
  "extends": "../../tsconfig.snaps.json",
  "compilerOptions": {
    "lib": ["ES2021", "DOM"],
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts", "**/*.tsx", "locales/*.json"]
}
