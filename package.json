{
  "name": "@metamask/internal-snaps-monorepo",
  "version": "23.0.0",
  "private": true,
  "description": "Monorepo for first-party snaps",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/internal-snaps.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --no-private --topological-dev --parallel --interlaced --verbose run build",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "yarn workspaces foreach --all --no-private --parallel --interlaced --verbose run build:docs",
    "build:only-clean": "rimraf -g 'packages/*/dist'",
    "changelog:update": "yarn workspaces foreach --all --no-private --parallel --interlaced --verbose run changelog:update",
    "changelog:validate": "yarn workspaces foreach --all --no-private --parallel --interlaced --verbose run changelog:validate",
    "create-release-branch": "create-release-branch --formatter oxfmt",
    "create-package": "tsx scripts/create-package",
    "lint": "yarn lint:tsc && yarn lint:eslint && echo && yarn lint:misc --check && yarn constraints && yarn lint:dependencies && yarn readme-content:check && yarn changelog:validate",
    "lint:dependencies": "depcheck && yarn dedupe --check",
    "lint:dependencies:fix": "depcheck && yarn dedupe",
    "lint:eslint": "yarn eslint",
    "lint:fix": "yarn lint:eslint --fix --prune-suppressions && echo && yarn lint:misc --write && yarn constraints --fix && yarn lint:dependencies:fix && yarn readme-content:update",
    "lint:misc": "oxfmt --ignore-path .gitignore",
    "lint:misc:check": "yarn lint:misc --check",
    "lint:tsc": "tsc --project tsconfig.json && yarn workspaces foreach --all exec tsc --project tsconfig.json --noEmit",
    "prepack": "./scripts/prepack.sh",
    "readme-content:check": "tsx scripts/update-readme-content.ts --check",
    "readme-content:update": "tsx scripts/update-readme-content.ts",
    "test": "yarn test:scripts --coverage.enabled=false && yarn test:packages",
    "test:clean": "yarn workspaces foreach --all --parallel --verbose run test:clean && yarn test",
    "test:packages": "yarn test:verbose --silent --coverage=false",
    "test:scripts": "vitest run --config ./vitest.config.scripts.ts --coverage --reporter=dot --silent",
    "test:verbose": "yarn workspaces foreach --all --parallel --verbose run test:verbose",
    "workspaces:list-versions": "./scripts/list-workspace-versions.sh"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@metamask/create-release-branch": "^4.2.2",
    "@metamask/eslint-config": "^15.0.1",
    "@metamask/eslint-config-nodejs": "^15.0.1",
    "@metamask/eslint-config-typescript": "^15.0.1",
    "@metamask/eslint-config-vitest": "^15.0.1",
    "@metamask/utils": "^11.11.0",
    "@types/lodash": "^4.17.15",
    "@types/node": "^24",
    "@types/semver": "^7",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/eslint-plugin": "^1.1.4",
    "@yarnpkg/types": "^4.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "execa": "^5.0.0",
    "isomorphic-fetch": "^3.0.0",
    "lodash": "^4.17.21",
    "nock": "^13.3.1",
    "oxfmt": "^0.70.0",
    "rimraf": "^6.0.1",
    "semver": "^7.6.3",
    "simple-git-hooks": "^2.8.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yargs": "^17.7.3"
  },
  "resolutions": {
    "@metamask/snaps-execution-environments": "11.3.0",
    "@metamask/snaps-sdk": "12.0.1",
    "@metamask/snaps-utils": "12.6.0",
    "@solana-name-service/sns-sdk-kit/@solana-program/token": "^0.16.1",
    "@types/react": "18.2.4",
    "@types/react-dom": "18.2.4",
    "axios@1.12.2": "1.20.0",
    "axios@1.18.0": "1.20.0",
    "elliptic@6.5.4": "^6.5.7",
    "fast-xml-parser@^4.3.4": "^4.4.1",
    "hash-base@npm:^3.0.0": "3.1.0",
    "proxy-addr": "2.0.8",
    "ripemd160@npm:^2.0.1": "2.0.2",
    "validator@13.15.20": "13.15.22",
    "ws@7.4.6": "^7.5.10",
    "ws@8.17.1": "8.21.0",
    "ws@8.18.0": "8.21.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24"
  },
  "packageManager": "yarn@4.17.1",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "simple-git-hooks": false,
      "tsx>esbuild": false,
      "eslint-plugin-jest>jest>@jest/core>jest-resolve>unrs-resolver": false
    }
  }
}
